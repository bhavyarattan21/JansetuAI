# Google Gemini API Key (Server-side only for /api/chat and /api/ai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Maps JavaScript API Key (Optional: for interactive map in Prepare & File)
# If not provided, JanSetu AI automatically falls back to Leaflet + OpenStreetMap seamlessly!
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Web Client ID (Public client-side credential)
VITE_GOOGLE_CLIENT_ID=763750528919-r050jj6b5t578jdhcr4he3h6jj0qi060.apps.googleusercontent.com
