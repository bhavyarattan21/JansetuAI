# Google Cloud OAuth 2.0 Web Client ID (Public client-side credential)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional Server-Side LLM API Key (Vercel Serverless Function /api/ai)
# JanSetu AI includes a high-fidelity template fallback so it works 100% even without this key!
GEMINI_API_KEY=your_gemini_api_key_here
